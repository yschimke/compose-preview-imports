{
  "$schema": "https://raw.githubusercontent.com/yschimke/compose-ai-tools/main/scripts/design-artifacts/catalog.spec.schema.json",
  "$comment": "Cover sheet for an IMPORTED project, plus the inventory it cannot supply for itself. A first-party catalog declares its components with @CatalogComponent / @CatalogVariant beside the @Preview functions and omits `groups` entirely; a project imported without its maintainers' involvement has no such annotations, so the inventory is written down HERE. That is the one thing an import costs, and it is the honest place for it: this is our description of somebody else's code, and it stays in our repository. Imported from upstream. Dropped fork-authored previews not present upstream: ExplicitIconThemePreview, IconButtonSmallThemePreview, PocketCastsAccountScreenPreview, PocketCastsSettingsScreenPreview, ToggleButtonGroupThemePreview",
  "system": "pocketcasts",
  "title": "Pocket Casts",
  "library": [
    "Compose Material 2 + Pocket Casts theme roles"
  ],
  "module": "modules:services:compose",
  "modes": [
    "light",
    "dark"
  ],
  "breakpoints": [
    {
      "size": "compact",
      "widthDp": 412
    },
    {
      "size": "medium",
      "widthDp": 700
    }
  ],
  "display": {
    "surface": "light",
    "hero": "Buttons/Row button"
  },
  "groupOrder": [
    "Buttons",
    "Inputs",
    "Content",
    "Feedback",
    "Chrome",
    "Settings",
    "Identity",
    "Ads",
    "Insights",
    "Motion"
