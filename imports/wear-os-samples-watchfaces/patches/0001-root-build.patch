+include(":wff:flavors")
+project(":wff:flavors").projectDir = file("WatchFaceFormat/Flavors/watchface")
+include(":wff:photos-mask")
+project(":wff:photos-mask").projectDir = file("WatchFaceFormat/PhotosMask/watchface")
+include(":wff:photos-multi")
+project(":wff:photos-multi").projectDir = file("WatchFaceFormat/PhotosMulti/watchface")
+include(":wff:simple-analog")
+project(":wff:simple-analog").projectDir = file("WatchFaceFormat/SimpleAnalog/watchface")
+include(":wff:simple-digital")
+project(":wff:simple-digital").projectDir = file("WatchFaceFormat/SimpleDigital/watchface")
+include(":wff:weather")
+project(":wff:weather").projectDir = file("WatchFaceFormat/Weather/watchface")
+include(":wfp:default")
+project(":wfp:default").projectDir = file("WatchFacePush/samples/defaultwf")
+include(":wfp:firefly")
+project(":wfp:firefly").projectDir = file("WatchFacePush/samples/firefly")
+include(":wfp:river")
