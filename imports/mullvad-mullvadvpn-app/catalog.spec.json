{
  "$schema": "https://raw.githubusercontent.com/yschimke/compose-ai-tools/main/scripts/design-artifacts/catalog.spec.schema.json",
  "$comment": "Cover sheet for an IMPORTED project, plus the inventory it cannot supply for itself. A first-party catalog declares its components with @CatalogComponent / @CatalogVariant beside the @Preview functions and omits `groups` entirely; a project imported without its maintainers' involvement has no such annotations, so the inventory is written down HERE. That is the one thing an import costs, and it is the honest place for it: this is our description of somebody else's code, and it stays in our repository.",
  "system": "mullvad-mullvadvpn-app",
  "title": "Mullvad VPN",
  "module": "lib:ui:designsystem",
  "modes": [
    "light",
    "dark"
  ],
  "groups": [
    {
      "name": "Buttons",
      "components": [
        {
          "componentId": "primary-button",
          "preview": "PreviewPrimaryButtonEnabled",
          "caption": "The primary button — the green Mullvad connect action, enabled."
        },
        {
          "componentId": "primary-button-disabled",
          "preview": "PreviewPrimaryButtonDisabled",
          "caption": "And disabled."
        },
        {
          "componentId": "variant-button",
          "preview": "PreviewVariantButtonEnabled",
          "caption": "The variant button, enabled."
        },
        {
          "componentId": "variant-button-disabled",
          "preview": "PreviewVariantButtonDisabled",
          "caption": "Disabled."
        },
        {
          "componentId": "negative-button",
          "preview": "PreviewNegativeButtonEnabled",
          "caption": "The negative button — disconnect, and the destructive settings actions."
        },
        {
          "componentId": "negative-button-disabled",
          "preview": "PreviewNegativeButtonDisabled",
          "caption": "Disabled."
        },
        {
          "componentId": "text-button",
          "preview": "PreviewTextButtonEnabled",
          "caption": "The text button."
        },
        {
          "componentId": "text-button-disabled",
          "preview": "PreviewTextButtonDisabled",
          "caption": "And disabled — four button roles, each previewed in both states, which is unusually complete."
        }
      ]
    },
    {
      "name": "Selection",
      "components": [
        {
          "componentId": "checkbox",
          "preview": "PreviewCheckbox",
          "caption": "The checkbox."
        },
        {
          "componentId": "switch",
          "preview": "PreviewMullvadSwitch",
          "caption": "The switch, in Mullvad's own colours rather than Material's."
        },
        {
          "componentId": "filter-chip-enabled",
          "preview": "PreviewEnabledMullvadFilterChip",
          "caption": "The filter chip that narrows the relay list, enabled."
        },
        {
          "componentId": "filter-chip-disabled",
          "preview": "PreviewDisabledMullvadFilterChip",
          "caption": "Disabled."
        },
        {
          "componentId": "filter-chip-inactive",
          "preview": "PreviewInactiveMullvadFilterChip",
          "caption": "And inactive — the third state the relay filters need."
        },
        {
          "componentId": "feature-chip",
          "preview": "PreviewMullvadFeatureChip",
          "caption": "The feature chip that marks what a relay supports."
        }
      ]
    },
    {
      "name": "Lists",
      "components": [
        {
          "componentId": "list-item-leading",
          "preview": "PreviewLeadingListItem",
          "caption": "A list item with leading content."
        },
        {
          "componentId": "list-item-leading-content",
          "preview": "PreviewLeadingContentListItem",
          "caption": "Its leading-content variant."
        },
        {
          "componentId": "list-item-trailing",
          "preview": "PreviewTrailingListItem",
          "caption": "With trailing content."
        },
        {
          "componentId": "list-item-hierarchy",
          "preview": "PreviewHierarchyListItem",
          "caption": "The hierarchical item — how the relay list nests country, city and server."
        },
        {
          "componentId": "list-item-positions",
          "preview": "PreviewListItemPositions",
          "caption": "Every position in a group at once: first, middle, last, and the shapes each takes."
        },
        {
          "componentId": "list-header",
          "preview": "PreviewListHeader",
          "caption": "The list header."
        }
      ]
    },
    {
      "name": "Feedback",
      "components": [
        {
          "componentId": "progress-indicator",
          "preview": "PreviewMullvadProgressIndicator",
          "caption": "The circular progress indicator, which is what a tunnel negotiating looks like."
        }
      ]
    }
  ]
}
