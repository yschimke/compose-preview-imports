diff --git a/Jetcaster/mobile/src/main/java/com/example/jetcaster/ui/tooling/SharedElementPreviewScope.kt b/Jetcaster/mobile/src/main/java/com/example/jetcaster/ui/tooling/SharedElementPreviewScope.kt
